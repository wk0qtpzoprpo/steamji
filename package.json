{
  "name": "asf-ipc-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create asf-ipc-console",
    "db:migrate": "wrangler d1 migrations apply asf-ipc-console",
    "kv:create": "wrangler kv namespace create KV",
    "test": "node --experimental-strip-types --test functions/lib/__tests__/crypto.test.ts functions/lib/__tests__/jwt.test.ts functions/lib/__tests__/ids.test.ts functions/lib/__tests__/sanitize.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^3.80.0"
  }
}
